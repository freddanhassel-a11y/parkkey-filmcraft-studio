# Browser-safe ParkKey/CoreOS Supabase configuration
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_publishable_key
SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_publishable_key

# LinkedIn production transport — SERVER ONLY.
# Never expose these as VITE_* variables or commit real values.
LINKEDIN_ACCESS_TOKEN=replace_server_only
LINKEDIN_API_VERSION=202608

# Optional OAuth application configuration for a future interactive consent flow.
# A LinkedIn Developer application and LinkedIn's own consent screen are required.
LINKEDIN_CLIENT_ID=replace_server_only
LINKEDIN_CLIENT_SECRET=replace_server_only
LINKEDIN_REDIRECT_URI=https://your-production-host.example/api/linkedin/oauth/callback

# Optional image generation provider currently used by Social Creative.
LOVABLE_API_KEY=replace_server_only
